DATABASE_URL=postgres://zhibi:zhibi@localhost:5432/zhibi
STUDENT_PROJECT_DATA_DIR=
# Production Docker image requires cloudbase (shared PG) or external postgres,
# plus a verified FULL live migration receipt. No purchase is automatic.
# Leave blank for local development only. Never set on the old ephemeral service.
ZHIBI_PERSISTENCE_MODE=
# Personal/shared PG: server-only API Key issued for this runtime, not MCP login.
# Set ZHIBI_PERSISTENCE_MODE=cloudbase only after full live migration verification.
TCB_ENV=
CLOUDBASE_APIKEY=
STUDENT_PG_BUCKET=zhibi-originals
# This release may explicitly migrate ELSE only, never claim a full-site backup.
ZHIBI_RELEASE_ACCOUNT=
ZHIBI_RELEASE_STUDENT_ID=
# One persistent PostgreSQL can serve business JSON, learner records and Mastra.
# Keep blank until source data, uploads and native memory are migrated and verified.
LEARNING_DATABASE_URL=
# Optional per-domain overrides. Never expose these values in the browser.
LEARNER_DATABASE_URL=
STUDENT_STORE_DATABASE_URL=
MASTRA_DATABASE_URL=
MASTRA_DATABASE_AUTH_TOKEN=
# Set only for a verified persistent mount; not for an ephemeral container directory.
MASTRA_STORAGE_DURABLE=0
MASTRA_MEMORY_MODE=native
MASTRA_OM_ENABLED=1
# Original uploads use an existing private S3/COS-compatible bucket.
STUDENT_OBJECT_ENDPOINT=
STUDENT_OBJECT_BUCKET=
STUDENT_OBJECT_REGION=
STUDENT_OBJECT_ACCESS_KEY=
STUDENT_OBJECT_SECRET_KEY=
# Paid profile reflection remains disabled until explicitly enabled.
LEARNER_REFLECTION_ENABLED=0
# Login/session restoration reconciles evidence after this account interval.
# Original student errors are never rewritten; reflection keeps its own switch.
LEARNER_TRACKING_ENABLED=1
LEARNER_SCAN_INTERVAL_HOURS=24
LEARNER_IDLE_MINUTES=30
LEARNER_EXTERNAL_WORKER=0
# Production private timer uses a separate random bearer secret; never expose to clients.
LEARNER_WORKER_KEY=
LEARNER_DAILY_RUN_LIMIT=12
LEARNER_DAILY_TOKEN_LIMIT=120000
LEARNING_WORKER_KEY=
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=zhibi
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=zhibi-writing

# DeepSeek handles text diagnosis and teaching conversations.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-chat

# Alibaba Bailian handles handwriting OCR.
DASHSCOPE_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
ADMIN_APPROVAL_CODE=
DASHSCOPE_OCR_MODEL=qwen3.5-ocr

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# Library v1 rollout: enable only after SQL migration, original-object storage,
# and the independent worker have been verified. Defaults keep legacy upload.
LIBRARY_INGEST_ENABLED=0
LIBRARY_READ_INDEX=0
LIBRARY_BACKGROUND_ENABLED=0
LIBRARY_WORKER_KEY=
LIBRARY_SERVICE_URL=http://127.0.0.1:3002

# Independent daily task wake-up (not a browser timer). Keep this key server-side.
# Reuse an existing always-on host; no automatic paid resource provisioning.
DAILY_TASK_WORKER_KEY=
DAILY_TASK_BASE_URL=http://127.0.0.1:3002
# Declare only when the business store really survives restart/deploy.
STUDENT_STORE_DURABLE=0
# Public-before-personal provider prefix layout; 0 rolls back ordering only.
# This is not a cache-hit guarantee and never shares private student content.
ZHIBI_PREFIX_CACHE_LAYOUT=1
# Local opt-in for task-scoped assembly; baseline is the default and rollback.
ZHIBI_CONTEXT_ASSEMBLY=baseline
# Shared request safeguards. Optional overrides; no new paid resource required.
ZHIBI_AI_REQUESTS_PER_HOUR=60
ZHIBI_AI_REQUESTS_PER_DAY=300
ZHIBI_AI_CONCURRENT=2
ZHIBI_AUTH_GLOBAL_PER_MINUTE=150
# Set only after verifying the gateway overwrites this single-IP header.
# Arbitrary caller-supplied X-Forwarded-For is NOT a trustworthy IP identity.
ZHIBI_TRUSTED_CLIENT_IP_HEADER=
