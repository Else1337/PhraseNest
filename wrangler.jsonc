{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhibi-english-rebuild",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "DEEPSEEK_API_KEY",
      "DASHSCOPE_API_KEY",
      "ADMIN_APPROVAL_CODE"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*"
    ],
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "zhibi-english-data"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "MASTRA_DB",
      "database_name": "zhibi-mastra-memory",
      "database_id": "00000000-0000-4000-a000-000000000000"
    }
  ]
}
