{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zhibi/gaokao-writing-review-v1.schema.json",
  "title": "Zhibi English writing feedback v1",
  "description": "Use this as a structured output contract. predicted_score is an estimate, never an official score. The host verifies quotation provenance and rubric authority separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "genre", "rubric", "input", "assessment", "overview", "dimensions", "issues", "upgrade_plan"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "genre": {"enum": ["practical", "continuation", "other"]},
    "rubric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "max_score", "authority", "source_url", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "max_score": {"type": "integer", "enum": [15,25]},
        "authority": {"enum": ["provided_for_exam", "verified_exam", "public_reference", "general_reference"]},
        "source_url": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_status", "source_status", "student_text", "word_count", "ocr_uncertain"],
      "properties": {
        "prompt_status": {"enum": ["complete", "partial", "missing"]},
        "source_status": {"enum": ["complete", "partial", "missing", "not_applicable"]},
        "student_text": {"type": "string"},
        "word_count": {"type": ["integer", "null"], "minimum": 0},
        "ocr_uncertain": {"type": "boolean"}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicted_score", "plausible_range", "band", "confidence", "reason", "missing_evidence"],
      "properties": {
        "status": {"enum": ["estimated", "rough_only", "not_scored"]},
        "predicted_score": {"type": ["integer", "null"], "minimum": 0},
        "plausible_range": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "band": {"type": ["string", "null"]},
        "confidence": {"enum": ["high", "medium", "low", "not_applicable"]},
        "reason": {"type": "string"},
        "missing_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "overview": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "strength", "weakness", "evidence", "action"],
        "properties": {
          "dimension": {"enum": ["task_content", "story_content", "organization", "grammar", "lexis", "pragmatics"]},
          "strength": {"type": "string"},
          "weakness": {"type": "string"},
          "evidence": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "subtype", "location", "original_quote", "impact", "certainty", "why", "minimal_fix", "upgrade", "transfer_rule"],
        "properties": {
          "id": {"type": "string"},
          "label": {"enum": ["E", "R", "U", "S"]},
          "subtype": {"type": "string"},
          "location": {"type": "string"},
          "original_quote": {"type": "string"},
          "impact": {"enum": ["high", "medium", "low"]},
          "certainty": {"enum": ["high", "medium", "needs_confirmation"]},
          "why": {"type": "string"},
          "minimal_fix": {"type": ["string", "null"]},
          "upgrade": {"type": ["string", "null"]},
          "transfer_rule": {"type": ["string", "null"]}
        }
      }
    },
    "upgrade_plan": {"type": "array", "items": {"type": "string"}},
    "teaching": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["trigger", "concept", "explanation", "practice_optional"],
      "properties": {
        "trigger": {"type": "string"},
        "concept": {"type": "string"},
        "explanation": {"type": "string"},
        "practice_optional": {"type": ["string", "null"]}
      }
    },
    "revised_text": {"type": ["string", "null"]},
    "teacher_score": {"type": ["integer", "null"], "minimum": 0},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
